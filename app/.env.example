# Copy this file to app/.env and paste an AI Studio API key.
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Optional model used by `python main.py --text`.
GEMINI_TEXT_MODEL=gemini-3.6-flash
# Text mode uses the model's minimum supported thinking level in code.
# Warm the model connection before accepting the first text command.
GEMINI_TEXT_WARMUP=TRUE
# Simulated API latency per HTTP request. Use ROBOT_API_BASE_URL for a real API.
ROBOT_API_DELAY_MS=60
# ROBOT_API_BASE_URL=http://127.0.0.1:9000
# Optional SQLite path for persistent commands and robot action history.
# ROBOT_MEMORY_DB=app/robot_memory.db
